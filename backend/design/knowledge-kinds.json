[
  {
    "kind": "FACT",
    "table": "fact_details",
    "role": "객관적 속성의 술어와 형식화된 값",
    "index": "(predicate_code, value_type)",
    "checks": [
      "subject_scope IN ('SELF','RELATION')",
      "value_type IN ('TEXT','NUMBER','DATE','BOOLEAN')",
      "length(btrim(predicate_code)) > 0",
      "unit_code IS NULL OR value_type = 'NUMBER'"
    ]
  },
  {
    "kind": "MEMORY",
    "table": "memory_details",
    "role": "경험·사건의 유형과 장소·관련 인물·회상 특성",
    "index": "event_type",
    "checks": [
      "length(btrim(event_type)) > 0",
      "emotional_tone IN ('POSITIVE','NEGATIVE','MIXED','NEUTRAL','UNKNOWN')",
      "recall_precision IN ('EXACT','APPROXIMATE','UNKNOWN')"
    ]
  },
  {
    "kind": "VALUE",
    "table": "value_details",
    "role": "가치 판단 영역·원칙·중요도·적용 상황",
    "index": "(domain_code, priority_band)",
    "checks": [
      "length(btrim(domain_code)) > 0",
      "priority_band IS NULL OR priority_band BETWEEN 1 AND 5"
    ]
  },
  {
    "kind": "PREFERENCE",
    "table": "preference_details",
    "role": "선호 대상·호불호 방향·강도·조건",
    "index": "(target_type, polarity)",
    "checks": [
      "length(btrim(target_type)) > 0",
      "polarity IN ('LIKE','DISLIKE','MIXED','NEUTRAL')",
      "strength IS NULL OR strength BETWEEN 1 AND 5"
    ]
  },
  {
    "kind": "BEHAVIOR",
    "table": "behavior_details",
    "role": "행동 종류·발생 계기·빈도·습관성",
    "index": "(action_code, frequency_unit)",
    "checks": [
      "length(btrim(action_code)) > 0",
      "frequency_unit IN ('DAY','WEEK','MONTH','YEAR','OCCASIONAL','UNKNOWN')",
      "frequency_count IS NULL OR frequency_count > 0",
      "frequency_unit NOT IN ('OCCASIONAL','UNKNOWN') OR frequency_count IS NULL",
      "automaticity IN ('HABIT','DELIBERATE','UNKNOWN')"
    ]
  }
]
