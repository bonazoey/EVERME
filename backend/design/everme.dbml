Project EVERME {
  database_type: 'PostgreSQL'
  Note: '2026-11-26 상세 설계. 약관 테이블 제거 후 22 + 분류 상세 5 = 핵심 27; 그룹 API 저장 보완 1 = 총 28. 실행 migration 아님. backend/design/BACKEND_ARCHITECTURE.md 참조.'
}

Enum sensitivity_level {
  L1
  L2
  L3
  L4
}

Enum session_kind {
  personal
  spokesperson
}

Enum message_role {
  user
  assistant
}

Enum information_kind {
  FACT
  MEMORY
  VALUE
  PREFERENCE
  BEHAVIOR
}

Enum invitation_status {
  pending
  accepted
  rejected
  expired
  cancelled
}

Table accounts {
  id uuid [pk]
  email varchar(254) [not null, unique, note: '정규화한 로그인 이메일. 가입 필드 상세는 설계 가정']
  password_hash text [note: '소셜 전용 계정은 null. NFR-008 단방향 해시']
  display_name varchar(100) [not null]
  profile_image_key text
  voice_code varchar(100) [note: 'FR-019 선택 기능. 외부 TTS 음성 식별자']
  is_active boolean [not null, default: true]
  deactivated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'FR-001~007. 사용자/정보이용자는 고정 역할이 아닌 관계에 따른 역할.'
}

Table social_identities {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  provider varchar(50) [not null]
  provider_subject varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (provider, provider_subject) [unique] }
  Note: 'FR-004. 제공자 종류 및 계정 연결 정책은 미정.'
}

Table auth_sessions {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  refresh_token_hash text [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'FR-002~003. 토큰 방식은 설계 가정. 로그아웃 즉시 접근 차단은 서버 검증 필요.'
}

Table password_reset_tokens {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'FR-005. 원문 토큰 저장 금지, 만료·일회성 소비는 서비스에서 검증.'
}

Table deactivation_requests {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  status varchar(30) [not null, note: 'pending / processing / completed / failed']
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  Note: 'FR-007, NFR-013. 계정 및 원본·분석·파생 데이터 비활성화 작업 추적.'
}

Table clones {
  id uuid [pk]
  owner_id uuid [not null, unique, ref: > accounts.id]
  data_revision bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true, note: '개인정보 비활성화 전파용. 별도 활성화 신청 기능 아님']
  Note: 'FR-046~047,053. 소유자당 한 클론 가정. 접근 시 동의와 권한을 별도 검증.'
}

Table clone_assessments {
  id uuid [pk]
  clone_id uuid [not null, ref: > clones.id]
  data_revision bigint [not null]
  result_ciphertext text [not null, note: '영역별 충분성·부족 영역 평가 결과 암호문. 정량 점수 공식은 미정']
  encryption_key_id varchar(100) [not null]
  is_active boolean [not null, default: true]
  evaluated_at timestamptz [not null, default: `now()`]
  Note: 'FR-055. 프로필 직접 편집·클론 테스트·피드백 테이블은 포함하지 않음.'
}

Table clone_invitations {
  id uuid [pk]
  clone_id uuid [not null, ref: > clones.id]
  recipient_email varchar(254) [not null]
  recipient_account_id uuid [ref: > accounts.id]
  token_hash text [not null, unique]
  proposed_level sensitivity_level [not null]
  status invitation_status [not null, default: 'pending']
  expires_at timestamptz [not null]
  responded_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]
  Note: 'FR-071~073. 미가입 이메일 초대 지원은 설계 가정. 수락 시 본인 확인 후 권한 생성.'
}

Table clone_permissions {
  id uuid [pk]
  clone_id uuid [not null, ref: > clones.id]
  consumer_id uuid [not null, ref: > accounts.id]
  group_id uuid
  max_level sensitivity_level [not null]
  granted_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  is_active boolean [not null, default: true]
  indexes {
    (clone_id, consumer_id) [unique]
    (group_id, clone_id)
  }
  Note: 'group_id/clone_id 복합 FK로 다른 소유자의 그룹 배정 금지. 개인별 수정은 현재 max_level을 변경하며, 후속 그룹 일괄 변경은 그룹 구성원 전원에 다시 적용. 충돌하는 별도 카테고리 ACL 없음.'
}

Table conversation_sessions {
  id uuid [pk]
  participant_id uuid [not null, ref: > accounts.id]
  kind session_kind [not null]
  clone_id uuid [ref: > clones.id, note: 'personal은 null, spokesperson은 필수']
  title_ciphertext text
  summary_ciphertext text [note: 'FR-029. 원문 전체 수준으로 보호, 정보이용자에게 그대로 노출하지 않음']
  encryption_key_id varchar(100) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (participant_id, is_active, updated_at) }
  Note: 'FR-021~023,027,029,070. 개인 대화와 대변인 대화를 분리하고 대변인 발언은 소유자 분석 입력에서 제외.'
}

Table messages {
  id uuid [pk]
  session_id uuid [not null, ref: > conversation_sessions.id]
  sequence_no int [not null]
  role message_role [not null]
  input_mode varchar(10) [not null, note: 'text / voice']
  generation_status varchar(20) [not null, note: 'pending / streaming / completed / interrupted / failed']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes { (session_id, sequence_no) [unique] }
  Note: 'FR-009~020,026. 원문은 revisions에 저장. 음성 원본 저장은 요구되지 않아 제외.'
}

Table message_revisions {
  id uuid [pk]
  message_id uuid [not null, ref: > messages.id]
  revision_no int [not null]
  content_ciphertext text [not null]
  encryption_key_id varchar(100) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes { (message_id, revision_no) [unique] }
  Note: 'FR-026,039. 출처가 정정 전후 어떤 원문인지 추적. 최신 revision이 표시 대상.'
}

Table analysis_jobs {
  id uuid [pk]
  source_revision_id uuid [not null, unique, ref: > message_revisions.id]
  owner_id uuid [not null, ref: > accounts.id]
  status varchar(20) [not null, default: 'queued']
  lease_token uuid
  lease_until timestamptz
  locked_by varchar(100)
  attempt_count int [not null, default: 0]
  max_attempts int [not null, default: 3]
  model_code varchar(100)
  analyzer_revision varchar(100) [not null]
  new_count int [not null, default: 0]
  duplicate_count int [not null, default: 0]
  temporal_change_count int [not null, default: 0]
  conflict_count int [not null, default: 0]
  classification_failed_count int [not null, default: 0]
  failure_code varchar(80)
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  is_active boolean [not null, default: true]
  indexes { (status, is_active, lease_until, created_at) }
  checks {
    `status IN ('queued','running','completed','failed','cancelled')` [name: 'ck_analysis_status']
    `attempt_count >= 0 AND max_attempts > 0 AND attempt_count <= max_attempts` [name: 'ck_analysis_attempt']
    `(status = 'running' AND lease_token IS NOT NULL AND lease_until IS NOT NULL AND locked_by IS NOT NULL) OR (status <> 'running' AND lease_token IS NULL AND lease_until IS NULL AND locked_by IS NULL)` [name: 'ck_analysis_lease']
    `new_count >= 0 AND duplicate_count >= 0 AND temporal_change_count >= 0 AND conflict_count >= 0 AND classification_failed_count >= 0` [name: 'ck_analysis_counts']
    `(status IN ('completed','failed','cancelled')) = (completed_at IS NOT NULL)` [name: 'ck_analysis_completed']
  }
  Note: 'TX-1 원문과 함께 INSERT. TX-3 SKIP LOCKED 점유 후 커밋. TX-4 lease token/기한 확인 및 원문 활성 재확인 후 지식·상세·출처·인덱싱 작업·완료를 원자 저장. 분류 실패는 completed + 실패 개수, 재시도 없음. running lease 만료만 최대 횟수 내 재점유.'
}

Table knowledge_items {
  id uuid [pk]
  owner_id uuid [not null, ref: > accounts.id]
  kind information_kind [not null]
  semantic_key varchar(64) [not null, note: '소유자 범위의 정규화된 항목 정체성 HMAC. 값 자체가 아니라 주체·술어·대상·상황 식별. 비밀 HMAC 키 보호']
  occurrence_count int [not null, default: 1]
  change_count int [not null, default: 0]
  lock_version int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (id, kind) [unique, name: 'uq_item_kind']
    (owner_id, kind, semantic_key) [unique, name: 'uq_item_identity']
    (owner_id, kind, is_active)
  }
  checks {
    `occurrence_count >= 0 AND change_count >= 0 AND lock_version >= 0` [name: 'ck_item_counts']
    `length(semantic_key) = 64` [name: 'ck_item_semantic_key']
  }
  Note: 'FACT/MEMORY/VALUE/PREFERENCE/BEHAVIOR 5종. kind와 owner_id는 불변. HMAC 정규화가 다른 의미를 완벽히 식별하지는 않으므로 최종 중복·변경 검증은 Analyzer/MergeService 책임. 같은 owner의 TX-4는 계정 행 잠금으로 직렬화.'
}

Table knowledge_versions {
  id uuid [pk]
  item_id uuid [not null]
  kind information_kind [not null, note: '상세 테이블 배타성을 위한 타입 가드. item.kind와 복합 FK로 일치']
  version_no int [not null]
  content_ciphertext text [not null]
  encryption_key_id varchar(100) [not null]
  sensitivity sensitivity_level [not null]
  occurred_from timestamptz
  occurred_until timestamptz
  recorded_at timestamptz [not null, default: `now()`]
  superseded_at timestamptz
  is_active boolean [not null, default: true]
  indexes {
    (item_id, version_no) [unique]
    (id, kind) [unique, name: 'uq_version_kind']
    (item_id, is_active, recorded_at)
  }
  checks {
    `version_no > 0` [name: 'ck_version_no']
    `occurred_from IS NULL OR occurred_until IS NULL OR occurred_from <= occurred_until` [name: 'ck_version_period']
    `superseded_at IS NULL OR superseded_at >= recorded_at` [name: 'ck_version_superseded']
  }
  Note: '버전당 같은 kind의 상세 1행 필수. 복합 FK+상세 상수 CHECK로 다른 종류 혼합 금지. 정확히 1개 존재는 DEFERRABLE INITIALLY DEFERRED constraint trigger 설계로 보완. SQL 보완안 참조. 내용·종류·민감도는 불변; 변경은 새 버전.'
}

Table knowledge_sources {
  version_id uuid [not null, ref: > knowledge_versions.id]
  message_revision_id uuid [not null, ref: > message_revisions.id]
  analysis_job_id uuid [not null, ref: > analysis_jobs.id]
  candidate_no int [not null]
  is_active boolean [not null, default: true]
  indexes {
    (version_id, message_revision_id) [pk]
    (analysis_job_id, candidate_no, message_revision_id) [unique]
    (message_revision_id, is_active)
  }
  checks { `candidate_no > 0` [name: 'ck_source_candidate'] }
  Note: '원문 N:M 근거. candidate_no는 한 분석 작업 내 원자 추출 순번. 완료 TX 원자성+유일성으로 재점유 중복 커밋 방지. 같은 지식/원문 연결은 ON CONFLICT 재삽입 안 함. 소유자·personal/user 발언 여부는 서비스 및 보완 트리거 검증 대상.'
}

Table knowledge_conflicts {
  id uuid [pk]
  existing_version_id uuid [not null, ref: > knowledge_versions.id]
  incoming_version_id uuid [not null, ref: > knowledge_versions.id]
  status varchar(20) [not null, default: 'open']
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]
  indexes { (existing_version_id, incoming_version_id) [unique] }
  checks {
    `existing_version_id <> incoming_version_id` [name: 'ck_conflict_distinct']
    `existing_version_id < incoming_version_id` [name: 'ck_conflict_order']
    `status IN ('open','resolved','dismissed')` [name: 'ck_conflict_status']
  }
  Note: '같은 owner/item의 충돌만 허용하도록 서비스/보완 제약 검토. 정렬된 버전 ID 쌍으로 INSERT하여 역방향 중복 방지. 충돌은 기존 사실을 덮어쓰지 않음.'
}

Table response_segments {
  id uuid [pk]
  message_id uuid [not null, ref: > messages.id]
  sequence_no int [not null]
  kind varchar(20) [not null, note: 'fact / inference / notice. 표시 구분 방식은 설계 가정']
  content_ciphertext text [not null]
  uncertainty_ciphertext text [note: 'FR-065. 근거 부족·충돌 설명. 확률 점수는 미정이므로 제외']
  encryption_key_id varchar(100) [not null]
  is_active boolean [not null, default: true]
  indexes { (message_id, sequence_no) [unique] }
  Note: 'FR-062~066. 검증된 assistant 응답만 분절 저장. 고위험 안내는 notice로 표현 가능.'
}

Table response_evidence {
  segment_id uuid [not null, ref: > response_segments.id]
  knowledge_version_id uuid [not null, ref: > knowledge_versions.id]
  is_active boolean [not null, default: true]
  indexes { (segment_id, knowledge_version_id) [pk] }
  Note: 'FR-064,069,NFR-023. 생성 당시 정보 버전 참조. 출처 열람 시 현재 권한을 다시 검증.'
}

Table audit_events {
  id uuid [pk]
  actor_id uuid [ref: > accounts.id, note: '미인증 접근 시 null']
  owner_id uuid [ref: > accounts.id]
  clone_id uuid [ref: > clones.id]
  session_id uuid [ref: > conversation_sessions.id]
  action varchar(80) [not null, note: 'clone_access / source_read / permission_change / permission_revoke 등']
  outcome varchar(20) [not null, note: 'allowed / denied / failed']
  permission_id uuid [ref: > clone_permissions.id]
  old_level sensitivity_level
  new_level sensitivity_level
  reason_code varchar(80)
  occurred_at timestamptz [not null, default: `now()`]
  indexes { (owner_id, occurred_at) }
  Note: 'FR-078,NFR-014. 사용자 접근 이력과 필수 감사. 민감한 원문·토큰은 로그에 저장하지 않음. 보존 정책은 미정.'
}

TableGroup account_management {
  accounts
  social_identities
  auth_sessions
  password_reset_tokens
  deactivation_requests
}

TableGroup clone_and_permissions {
  clones
  clone_assessments
  clone_invitations
  clone_permissions
  audit_events
}

TableGroup conversations {
  conversation_sessions
  messages
  message_revisions
  response_segments
  response_evidence
}

TableGroup knowledge {
  analysis_jobs
  knowledge_items
  knowledge_versions
  knowledge_sources
  knowledge_conflicts
}

Table member_groups {
  id uuid [pk]
  clone_id uuid [not null, ref: > clones.id]
  name varchar(100) [not null]
  default_level sensitivity_level [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (clone_id, name) [unique, name: 'uq_group_name']
    (id, clone_id) [unique, name: 'uq_group_clone']
    (clone_id, is_active)
  }
  checks { `length(btrim(name)) > 0` [name: 'ck_group_name'] }
  Note: '기존 그룹 API의 저장 누락 보완. 이용자당 최대 한 그룹. 그룹 변경은 구성원 clone_permissions.max_level을 같은 TX에서 일괄 갱신. 검색은 이 물질화된 현재 권한만 사용. 그룹 해제는 권한 철회와 다름.'
}

Table knowledge_embeddings {
  id uuid [pk]
  knowledge_version_id uuid [not null, ref: > knowledge_versions.id]
  owner_id uuid [not null, ref: > accounts.id]
  sensitivity sensitivity_level [not null]
  embedding vector [not null, note: '모델 선정 후 vector(d) 고정. 평문을 일시 복호화해 임베딩; 암호문 임베딩 불가']
  embedding_model varchar(150) [not null]
  source_fingerprint varchar(64) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (knowledge_version_id, embedding_model) [unique]
    (owner_id, sensitivity, is_active)
  }
  checks { `length(source_fingerprint) = 64` [name: 'ck_embedding_fingerprint'] }
  Note: '같은 PostgreSQL에서 지식 버전과 FK 연결. owner/민감도 복제는 최종 인가를 대체하지 않음. HNSW는 차원·모델 확정 후 SQL DDL로 추가. 버전 변경 시 새 벡터; 유효한 과거 버전 벡터는 유지. 삭제·정정으로 무효한 버전만 비활성화.'
}

Table embedding_jobs {
  id uuid [pk]
  knowledge_version_id uuid [not null, ref: > knowledge_versions.id]
  embedding_model varchar(150) [not null]
  source_fingerprint varchar(64) [not null]
  status varchar(20) [not null, default: 'queued']
  lease_token uuid
  lease_until timestamptz
  locked_by varchar(100)
  attempt_count int [not null, default: 0]
  max_attempts int [not null, default: 3]
  failure_code varchar(80)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    (knowledge_version_id, embedding_model) [unique]
    (status, lease_until, created_at)
  }
  checks {
    `status IN ('queued','running','completed','failed','cancelled')` [name: 'ck_embedding_job_status']
    `attempt_count >= 0 AND max_attempts > 0 AND attempt_count <= max_attempts` [name: 'ck_embedding_job_attempt']
    `(status = 'running' AND lease_token IS NOT NULL AND lease_until IS NOT NULL AND locked_by IS NOT NULL) OR (status <> 'running' AND lease_token IS NULL AND lease_until IS NULL AND locked_by IS NULL)` [name: 'ck_embedding_job_lease']
    `(status IN ('completed','failed','cancelled')) = (completed_at IS NOT NULL)` [name: 'ck_embedding_job_completed']
    `length(source_fingerprint) = 64` [name: 'ck_embedding_job_fingerprint']
  }
  Note: 'TX-4 유효 지식과 함께 INSERT. 별도 짧은 점유 TX 후 외부 API 호출, 저장 TX에서 token/활성/fingerprint 재검증. failed 자동 재시도 없음. 만료 running만 상한 내 재점유. 분류 실패 후보에는 작업 미생성.'
}

Table fact_details {
  version_id uuid [pk]
  kind information_kind [not null, default: 'FACT', note: '상수 타입 가드; 사용자 내용의 중복 저장이 아님']
  subject_scope varchar(12) [not null]
  predicate_code varchar(80) [not null]
  value_type varchar(12) [not null]
  value_ciphertext text [not null]
  unit_code varchar(20)
  indexes { (predicate_code, value_type) }
  checks {
    `kind = 'FACT'` [name: 'ck_fact_details_kind']
    `subject_scope IN ('SELF','RELATION')` [name: 'ck_fact_details_0']
    `value_type IN ('TEXT','NUMBER','DATE','BOOLEAN')` [name: 'ck_fact_details_1']
    `length(btrim(predicate_code)) > 0` [name: 'ck_fact_details_2']
    `unit_code IS NULL OR value_type = 'NUMBER'` [name: 'ck_fact_details_3']
  }
  Note: '객관적 속성의 술어와 형식화된 값. version_id PK로 버전당 최대 1행. content/owner/sensitivity/시점/활성/키 ID는 공통 버전·항목을 JOIN. 민감 실제 값은 ciphertext, 수치·코드도 접근등급 적용 및 DB/백업 암호화. 여러 종류 상세 혼합 금지는 타입 복합 FK, 누락 금지는 지연 제약 트리거.'
}

Table memory_details {
  version_id uuid [pk]
  kind information_kind [not null, default: 'MEMORY', note: '상수 타입 가드; 사용자 내용의 중복 저장이 아님']
  event_type varchar(80) [not null]
  location_ciphertext text
  participants_ciphertext text
  emotional_tone varchar(12) [not null, default: 'UNKNOWN']
  recall_precision varchar(12) [not null, default: 'UNKNOWN']
  indexes { event_type }
  checks {
    `kind = 'MEMORY'` [name: 'ck_memory_details_kind']
    `length(btrim(event_type)) > 0` [name: 'ck_memory_details_0']
    `emotional_tone IN ('POSITIVE','NEGATIVE','MIXED','NEUTRAL','UNKNOWN')` [name: 'ck_memory_details_1']
    `recall_precision IN ('EXACT','APPROXIMATE','UNKNOWN')` [name: 'ck_memory_details_2']
  }
  Note: '경험·사건의 유형과 장소·관련 인물·회상 특성. version_id PK로 버전당 최대 1행. content/owner/sensitivity/시점/활성/키 ID는 공통 버전·항목을 JOIN. 민감 실제 값은 ciphertext, 수치·코드도 접근등급 적용 및 DB/백업 암호화. 여러 종류 상세 혼합 금지는 타입 복합 FK, 누락 금지는 지연 제약 트리거.'
}

Table value_details {
  version_id uuid [pk]
  kind information_kind [not null, default: 'VALUE', note: '상수 타입 가드; 사용자 내용의 중복 저장이 아님']
  domain_code varchar(80) [not null]
  principle_ciphertext text [not null]
  priority_band smallint
  scope_ciphertext text
  indexes { (domain_code, priority_band) }
  checks {
    `kind = 'VALUE'` [name: 'ck_value_details_kind']
    `length(btrim(domain_code)) > 0` [name: 'ck_value_details_0']
    `priority_band IS NULL OR priority_band BETWEEN 1 AND 5` [name: 'ck_value_details_1']
  }
  Note: '가치 판단 영역·원칙·중요도·적용 상황. version_id PK로 버전당 최대 1행. content/owner/sensitivity/시점/활성/키 ID는 공통 버전·항목을 JOIN. 민감 실제 값은 ciphertext, 수치·코드도 접근등급 적용 및 DB/백업 암호화. 여러 종류 상세 혼합 금지는 타입 복합 FK, 누락 금지는 지연 제약 트리거.'
}

Table preference_details {
  version_id uuid [pk]
  kind information_kind [not null, default: 'PREFERENCE', note: '상수 타입 가드; 사용자 내용의 중복 저장이 아님']
  target_type varchar(40) [not null]
  target_ciphertext text [not null]
  polarity varchar(12) [not null]
  strength smallint
  context_ciphertext text
  indexes { (target_type, polarity) }
  checks {
    `kind = 'PREFERENCE'` [name: 'ck_preference_details_kind']
    `length(btrim(target_type)) > 0` [name: 'ck_preference_details_0']
    `polarity IN ('LIKE','DISLIKE','MIXED','NEUTRAL')` [name: 'ck_preference_details_1']
    `strength IS NULL OR strength BETWEEN 1 AND 5` [name: 'ck_preference_details_2']
  }
  Note: '선호 대상·호불호 방향·강도·조건. version_id PK로 버전당 최대 1행. content/owner/sensitivity/시점/활성/키 ID는 공통 버전·항목을 JOIN. 민감 실제 값은 ciphertext, 수치·코드도 접근등급 적용 및 DB/백업 암호화. 여러 종류 상세 혼합 금지는 타입 복합 FK, 누락 금지는 지연 제약 트리거.'
}

Table behavior_details {
  version_id uuid [pk]
  kind information_kind [not null, default: 'BEHAVIOR', note: '상수 타입 가드; 사용자 내용의 중복 저장이 아님']
  action_code varchar(80) [not null]
  trigger_ciphertext text
  frequency_unit varchar(12) [not null, default: 'UNKNOWN']
  frequency_count smallint
  automaticity varchar(12) [not null, default: 'UNKNOWN']
  indexes { (action_code, frequency_unit) }
  checks {
    `kind = 'BEHAVIOR'` [name: 'ck_behavior_details_kind']
    `length(btrim(action_code)) > 0` [name: 'ck_behavior_details_0']
    `frequency_unit IN ('DAY','WEEK','MONTH','YEAR','OCCASIONAL','UNKNOWN')` [name: 'ck_behavior_details_1']
    `frequency_count IS NULL OR frequency_count > 0` [name: 'ck_behavior_details_2']
    `frequency_unit NOT IN ('OCCASIONAL','UNKNOWN') OR frequency_count IS NULL` [name: 'ck_behavior_details_3']
    `automaticity IN ('HABIT','DELIBERATE','UNKNOWN')` [name: 'ck_behavior_details_4']
  }
  Note: '행동 종류·발생 계기·빈도·습관성. version_id PK로 버전당 최대 1행. content/owner/sensitivity/시점/활성/키 ID는 공통 버전·항목을 JOIN. 민감 실제 값은 ciphertext, 수치·코드도 접근등급 적용 및 DB/백업 암호화. 여러 종류 상세 혼합 금지는 타입 복합 FK, 누락 금지는 지연 제약 트리거.'
}

// BEGIN detailed knowledge refs
Ref group_clone: clone_permissions.(group_id, clone_id) > member_groups.(id, clone_id)
Ref version_item_kind: knowledge_versions.(item_id, kind) > knowledge_items.(id, kind)
Ref fact_details_version: knowledge_versions.(id, kind) - fact_details.(version_id, kind)
Ref memory_details_version: knowledge_versions.(id, kind) - memory_details.(version_id, kind)
Ref value_details_version: knowledge_versions.(id, kind) - value_details.(version_id, kind)
Ref preference_details_version: knowledge_versions.(id, kind) - preference_details.(version_id, kind)
Ref behavior_details_version: knowledge_versions.(id, kind) - behavior_details.(version_id, kind)
// END detailed knowledge refs

TableGroup knowledge_details {
  fact_details
  memory_details
  value_details
  preference_details
  behavior_details
}

TableGroup proposed_vector_indexing {
  knowledge_embeddings
  embedding_jobs
}

TableGroup group_access {
  member_groups
}
