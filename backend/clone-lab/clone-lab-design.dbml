  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'weight / sourceIds / reason']

  Note: '관심·선호: 특정 대상·활동에 대한 호불호. 제외: 가치의 중요도·실제 실행 빈도.'
}

Table clone_lab.profile_decision {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - clone_lab.users.id]
  research_depth decimal(5,2) [check: `research_depth BETWEEN 0 AND 100`, note: '정보 탐색의 깊이; 0~100 / NULL=미확인']
