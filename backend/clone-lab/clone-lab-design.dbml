  honesty decimal(5,2) [check: `honesty BETWEEN 0 AND 100`, note: '정직; 0~100 / NULL=미확인']
  loyalty decimal(5,2) [check: `loyalty BETWEEN 0 AND 100`, note: '충성·의리; 0~100 / NULL=미확인']
  privacy decimal(5,2) [check: `privacy BETWEEN 0 AND 100`, note: '사생활; 0~100 / NULL=미확인']
  health decimal(5,2) [check: `health BETWEEN 0 AND 100`, note: '건강; 0~100 / NULL=미확인']
  pleasure decimal(5,2) [check: `pleasure BETWEEN 0 AND 100`, note: '즐거움; 0~100 / NULL=미확인']
  creativity decimal(5,2) [check: `creativity BETWEEN 0 AND 100`, note: '창의성; 0~100 / NULL=미확인']
  expertise decimal(5,2) [check: `expertise BETWEEN 0 AND 100`, note: '전문성; 0~100 / NULL=미확인']
  recognition decimal(5,2) [check: `recognition BETWEEN 0 AND 100`, note: '사회적 인정; 0~100 / NULL=미확인']
  environment decimal(5,2) [check: `environment BETWEEN 0 AND 100`, note: '환경 보전; 0~100 / NULL=미확인']
  spirituality decimal(5,2) [check: `spirituality BETWEEN 0 AND 100`, note: '종교·영성; 0~100 / NULL=미확인']
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'weight / sourceIds / reason']

  Note: '가치관: 어떤 원칙과 삶의 목표를 중요하게 여기는지. 제외: 좋아하는 대상·실제 실천 빈도.'
}

