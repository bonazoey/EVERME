// Clone Lab DB 재설계 검토본 — 2026-11-28
// 2026-11-28: 기준 SQL·Java 및 로컬 실험 DB에 반영. 교체 migration은 clone_lab을 재생성한다.

Project CloneLabDesign {
  database_type: 'PostgreSQL'
  Note: '''
    14개 테이블: users / sessions / session_messages / runs / context / context_summaries / vector_store / profile_* 7개.
    sessions는 대화방, session_messages는 질문·답변 한 쌍의 영구 원문·벡터 저장소다.
    context는 JDBC ChatMemory의 최근 20쌍을 활성 상태로 조회하며 오래된 메시지는 논리 삭제한다. 임베딩은 없다.
    context_summaries는 대화방별 최근 5개 요약만 보존한다. 요약 생성은 최근 원문 창을 비우지 않는다.
    화면 이력은 session_messages 전체를 읽는다. context 정리·요약 삭제로 영구 원문을 삭제하지 않는다.
    최근 RAG는 owner의 전체 주제를 통합한 최신 100쌍을 먼저 선정하고 그 안에서 유사도 검색한다.
    최근 검색으로 부족하면 owner의 vector_store를 검색한다. 추론 질문에는 profile_*를 보완적으로 활용한다.
    viewer 대화·요약·AI의 추측은 owner 사실·장기 기억·성향 분석 근거로 사용하지 않는다.
    모든 PK는 테이블별 bigint 시퀀스다. profile_*의 사용자별 한 행·140개 점수·가중치와 profile_version은 유지한다.
    VectorStore의 bigint 문서 ID 발급·매핑, metadata 필터, HNSW 부분 인덱스와 JDBC dialect를 Java·SQL에 반영한다.
    문맥 전환·행 수 제한·범위 검증은 서버 책임이며 DBML의 CHECK만으로 실행되지 않는다.
  '''
}

Enum clone_lab.conversation_type {
  owner [note: '사용자가 자기 클론을 만들기 위해 나누는 대화']
  viewer [note: '정보이용자가 선택한 클론에게 질문하는 대화']
}

Enum clone_lab.message_status {
  pending [note: '아직 분석하지 않은 원문']
  analyzed [note: '분석 초안 보존 완료. 프로필·장기 기억 반영 전']
  saved [note: '처리 결과 저장 완료. owner는 프로필 반영, viewer는 이용자 문맥 처리이며 소유자 프로필을 갱신하지 않음']
  archived [note: 'owner 장기 기억 복사 완료 또는 viewer 문맥 처리 완료. 영구 원문은 유지하며 최근 100쌍은 sequence_no로 별도 선정']
}

Enum clone_lab.run_status {
  running [note: '생성·분석·저장을 진행 중']
  stopping [note: '새 작업은 시작하지 않고 이미 시작한 작업을 정리 중']
  paused [note: '현재 작업 정리 후 일시 중단. 같은 실행에서 재개 가능']
  failed [note: '오류로 중단. 체크포인트부터 재개하거나 취소 가능']
  completed [note: '목표 대화의 생성·분석·저장과 결과 보존을 완료']
  cancelled [note: '현재 작업 정리 후 실행 종료. 이미 반영한 프로필·기억을 되돌리지는 않음']
}

// JSON metadata.kind에서 허용하는 분류. 실제 독립 enum 컬럼은 없고 SQL CHECK로 검사한다.
Enum clone_lab.memory_kind {
  FACT [note: '직업·거주지 등 확인된 속성이나 사실']
  EXPERIENCE [note: '특정 시점의 사건·경험']
  PREFERENCE [note: '조건이 없는 대상·활동의 선호·기피']
  CONDITIONAL_PREFERENCE [note: '상황·상대 등 조건이 명시된 선호']
  VALUE [note: '중요하게 여기는 원칙·가치']
  HABIT [note: '실제로 반복하는 행동. 계획·희망과 구분']
  GOAL [note: '앞으로의 목표·의도·계획. 실현된 사실과 구분']
  RELATIONSHIP [note: '특정 인물과의 관계 정보']
}

Table clone_lab.users {
  id bigint [pk, increment, note: 'DB 시퀀스로 발급하는 사용자 ID. 같은 사람도 대화에 따라 owner 또는 viewer가 될 수 있음']
  name text [not null, note: '표시 이름']
  persona jsonb [note: '가상 인물 평가용 배경·정답. viewer에게는 없어도 되며 모델 입력에 전달하지 않음']
  profile_version bigint [not null, default: 0, note: '소유자 프로필 반영 시 증가. 낙관적 충돌 검사와 사용자 행 잠금을 함께 사용']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    profile_version을 유지한다. viewer 대화 처리로 다른 사람의 프로필 버전을 올리지 않는다.
    자동 실행 이력과 체크포인트는 runs에 저장한다. 사용자 행에는 run_state를 두지 않는다.
    viewer_context는 제거한다. 정보이용자 채팅은 sessions/session_messages/context/context_summaries를 사용하며 vector_store에는 저장하지 않는다.
    사용자 프로필 7개 영역의 행은 소유자 분석이 필요한 사용자에게 생성한다.
  '''
}

Table clone_lab.sessions {
  session_id bigint [pk, increment, note: '주제별 대화방 ID. 정보이용자는 서버가 소유자·이용자 조합으로 현재 대화방을 선택']
  memory_key varchar(36) [not null, unique, note: 'GENERATED ALWAYS AS (session_id::varchar(36)) STORED 예정. JDBC conversation_id의 문자열 FK 대상']
  owner_id bigint [not null, ref: > clone_lab.users.id, note: '클론 소유자']
  viewer_id bigint [not null, ref: > clone_lab.users.id, note: '실제 참여자. owner 대화에서는 owner_id와 동일']
  conversation_type clone_lab.conversation_type [not null]
  topic text [not null, default: '', note: '미입력 시 첫 10쌍으로 확정']
  analysis jsonb [not null, default: '{}', note: '고정 분석 구간·session_messages ID·분석 초안·저장 결과·중복 반영 방지 기록. context.id는 영구 근거로 사용하지 않음']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, viewer_id, conversation_type)
  }
  checks {
    `conversation_type <> 'owner' OR owner_id = viewer_id` [name: 'owner_session_viewer_matches']
  }
  Note: '''
    세션 전체 status는 없다. 분석 구간 상태는 analysis, 원문 처리 상태는 session_messages.status에 기록한다.
    문맥 요약은 context_summaries에서만 관리한다. 기존 분석용 요약을 유지하는 경우 문맥 요약과 별도로 구분한다.
    owner 분석·기억·완료 기록·profile_version·runs 저장 진행률은 같은 짧은 트랜잭션으로 반영한다.
    viewer 대화방은 owner_id+viewer_id로 격리하며 새 대화는 새 session_id로 구분한다.
    memory_key는 DBML에서 생성 표현식을 실행하지 않는다. 후속 SQL에서 생성 컬럼으로 구현한다.
    원문 pair_no 할당과 요약 전환은 세션별로 직렬화한다. LLM 호출은 DB 잠금 밖에서 수행하고 저장 시 경계를 재검증한다.
  '''
}

Table clone_lab.runs {
  run_id bigint [pk, increment, note: 'DB 시퀀스로 발급하는 자동 실행 ID']
  clone_owner_id bigint [not null, ref: > clone_lab.users.id, note: '프로필을 생성·갱신할 클론 소유자']
  session_id bigint [not null, unique, ref: > clone_lab.sessions.session_id, note: '실행 하나가 이어 쓰는 owner 세션. 재개 시 동일 실행·세션을 사용']
  mode text [not null, default: 'single-session-pipeline-v1', note: '실행 방식의 버전. 실행 시작 후 변경하지 않음']
  topic text [not null, note: '실행 시작 시 주제 스냅샷']
  status clone_lab.run_status [not null, default: 'paused']
  error text [note: '실패·중단 원인. 비밀 키 등 민감 정보를 포함하지 않음']
  target_pairs int [not null, default: 1000, note: '목표 대화 쌍 수. 현재 10쌍 구간 처리에 맞춰 10의 배수']
  generated_pairs int [not null, default: 0, note: 'DB에 원문·구간 등록을 완료한 누적 쌍 수. 생성 예약은 포함하지 않음']
  analyzed_pairs int [not null, default: 0, note: '분석 초안을 저장한 누적 쌍 수']
  saved_pairs int [not null, default: 0, note: '프로필·기억·구간 처리를 저장 완료한 누적 쌍 수. 최종 진행률 기준']
  input_tokens bigint [not null, default: 0]
  output_tokens bigint [not null, default: 0]
  cached_tokens bigint [not null, default: 0, note: '입력 토큰 중 캐시된 토큰. input_tokens에 별도로 더하지 않음']
  llm_elapsed_ms bigint [not null, default: 0, note: '텍스트 LLM 호출 시간 합계. 병행 실행으로 실제 활성 시간보다 클 수 있음']
  wall_elapsed_ms bigint [not null, default: 0, note: '지난 활성 구간의 누적 실제 경과 시간. 조회 시 현재 활성 구간 시간을 추가 계산']
  retry_count int [not null, default: 0]
  config jsonb [not null, default: `'{}'::jsonb`, note: '시작 시 고정한 단계별 모델·추론 강도·프롬프트/카탈로그/갱신 정책 버전·데이터셋 식별자 등 비교 조건']
  state jsonb [not null, default: `'{}'::jsonb`, note: 'generation/analysis 단계·생성 예약 범위·고정 구간 ID 등 복구 부가 정보. 상태·진행 수·사용량 컬럼을 중복 저장하지 않음']
  result jsonb [not null, default: `'{}'::jsonb`, note: '완료 당시 140개 점수·가중치·프로필 버전·근거 확보율·평가 결과. 이후 사용자 프로필이 바뀌어도 유지']
  created_at timestamptz [not null, default: `now()`]
  active_since timestamptz [note: '현재 활성 구간 시작 시각. running/stopping에서만 존재하며 재개 시 새로 설정']
  heartbeat_at timestamptz [note: '마지막 진행 체크포인트 시각. 재시작 복구 시 비활성 시간을 실행 시간에 포함하지 않도록 사용']
  finished_at timestamptz [note: 'completed 또는 cancelled가 확정된 시각. paused/failed는 재개할 수 있어 종료 시각을 두지 않음']

  indexes {
    (clone_owner_id, created_at) [name: 'runs_owner_history_idx']
    (status, heartbeat_at) [name: 'runs_recovery_idx']
    (clone_owner_id, status) [name: 'runs_owner_unfinished_lookup_idx']
  }
  checks {
    `target_pairs > 0 AND target_pairs % 10 = 0` [name: 'runs_target_full_segments']
    `0 <= saved_pairs AND saved_pairs <= analyzed_pairs AND analyzed_pairs <= generated_pairs AND generated_pairs <= target_pairs` [name: 'runs_progress_order']
    `status <> 'completed' OR saved_pairs = target_pairs` [name: 'runs_completed_target']
    `(status IN ('running','stopping')) = (active_since IS NOT NULL)` [name: 'runs_active_clock']
    `(status IN ('completed','cancelled')) = (finished_at IS NOT NULL)` [name: 'runs_finished_clock']
    `input_tokens >= 0 AND output_tokens >= 0 AND cached_tokens >= 0 AND cached_tokens <= input_tokens` [name: 'runs_token_counts']
    `llm_elapsed_ms >= 0 AND wall_elapsed_ms >= 0 AND retry_count >= 0` [name: 'runs_usage_nonnegative']
    `jsonb_typeof(config) = 'object' AND jsonb_typeof(state) = 'object' AND jsonb_typeof(result) = 'object'` [name: 'runs_json_objects']
  }

  Note: '''
    소유자당 미완료 실행은 하나만 허용한다. DBML의 일반 인덱스만으로는 이 규칙을 강제하지 않는다.
    보완 SQL에 UNIQUE INDEX ON runs(clone_owner_id) WHERE status IN ('running','stopping','paused','failed')를 추가해야 한다.
    복구 대상은 running/stopping이다. heartbeat_at까지의 활성 시간을 합산하고 paused로 변경한 뒤 재개한다.
    진행률은 컬럼이 기준이다. state에 같은 값의 별도 사본을 만들지 않는다. 예약을 포함한 미저장 구간 최대 2개 규칙은 서버에서 검증한다.
    session_id가 가리키는 세션이 owner 종류이고 clone_owner_id와 소유자가 같은지는 서버에서 검증한다.
    단순 진행률 변경은 runs 행만 잠근다. 프로필 저장은 users → runs → sessions 순으로 잠그고 모든 경로가 같은 순서를 따른다.
    외부 LLM·임베딩 호출은 트랜잭션 밖에서 수행한다. 최종 프로필·기억·구간 완료·실행 진행률은 하나의 짧은 트랜잭션으로 반영한다.
    stopping은 현재 작업을 마친 뒤 paused 또는 cancelled로 확정한다. 취소 의도는 state의 종료 요청으로 구분한다.
    cancelled는 이후 처리를 중단하는 기능이며 이미 반영한 점수·기억의 롤백을 의미하지 않는다.
    config는 실행 시작 후 고정한다. result는 완료 시 프로필과 평가 결과를 동결하며 이후 프로필에서 다시 계산하지 않는다.
    토큰·LLM 시간은 현재 텍스트 단계 집계다. 임베딩·실패 요청의 공급자 청구액 전체를 나타내는 비용 장부는 아니다.
    반복 실행은 같은 사용자 프로필에 누적된다. 독립 비교 실험은 동일 persona를 가진 별도 사용자와 동일 대화 데이터셋을 사용하는 방식이 적절하다.
    진행 중 설정 변경·완료 실행 재개는 허용하지 않는다. API·Java·실행 SQL 반영은 후속 작업이다.
  '''
}

Table clone_lab.session_messages {
  id bigint [pk, increment, note: '영구 대화 쌍 ID. 분석·요약·장기 기억의 출처']
  session_id bigint [not null, ref: > clone_lab.sessions.session_id]
  content text [not null, note: 'USER/ASSISTANT 역할이 구분된 질문·응답 전체 원문']
  embedding vector(1536) [note: 'owner는 사용자 발언, viewer는 질문·응답 쌍을 임베딩. viewer 검색은 해당 대화방으로 제한. 미준비 시 NULL']
  metadata jsonb [not null, default: '{}', note: 'VectorStore 검색용 owner_id/viewer_id/session_id/message_id는 10진 ID 문자열, conversation_type은 owner/viewer. 서버가 sessions 기준으로 설정. 선택: synthetic·시각 의미·응답 부가 정보']
  user_text text [not null]
  assistant_text text [not null]
  user_received_at timestamptz [not null, note: '질문 수신 시각. 합성 데이터는 요청 시각과 synthetic 표시를 함께 기록']
  assistant_received_at timestamptz [not null, note: '응답 수신 시각. 질문·응답의 실제 사건 발생 시각을 뜻하지 않음']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  sequence_no bigint [not null, increment, unique, note: '소유자 전체 세션의 최근 100쌍 선정용 전역 증가 순번. 공백 허용']
  pair_no bigint [not null, note: '대화방 내 1부터 시작하는 완료 대화 쌍 순번. 서버가 세션 잠금으로 할당']
  status clone_lab.message_status [not null, default: 'pending']

  indexes {
    (session_id, pair_no) [unique]
    (session_id, sequence_no)
    (status, sequence_no)
  }
  checks {
    `pair_no > 0` [name: 'message_pair_positive']
  }
  Note: '''
    화면은 세션별 전체 원문을 조회한다. archived여도 삭제하지 않는다. 처리된 원문을 같은 ID로 수정하지 않는다.
    소유자·참여자·대화 종류는 sessions에서만 관리하고 session_id FK로 연결한다. 권한 검증의 기준은 sessions다.
    metadata의 검색용 사본은 서버가 sessions 기준으로 설정·검증한다. metadata만으로 접근 권한을 판단하지 않는다.
    최신 100쌍은 sessions를 JOIN해 sessions.owner_id와 sessions.conversation_type='owner'로 필터하고 sequence_no 역순으로 먼저 선정한다.
    그 후보 안에서 embedding이 있는 문서만 유사도 검색한다. 세션 JOIN에는 (session_id, sequence_no) 인덱스를 사용한다.
    viewer는 질문·응답을 임베딩하고 최초 상태 saved다. 검색은 owner/viewer/session 범위를 모두 고정한다.
    최신 범위 판단에 status를 사용하지 않는다. 임베딩 누락을 오래된 대화로 채워 100쌍 범위를 넓히지 않는다.
    owner 분석 저장·embedding 준비 후 최신 100쌍 밖 원문을 vector_store에 복사하고 status를 archived로 원자 갱신한다.
    viewer는 이력·해당 대화방 문맥 검색에만 사용한다. 분석·owner 검색·장기 기억에서 제외한다.
    후속 SQL에 embedding IS NOT NULL 조건의 HNSW 인덱스를 추가한다. 기본 PgVectorStore만으로 최근 후보 제한이 자동 적용되지는 않는다.
    실제 수신 시각은 여기 보존한다. ChatMemory의 재작성 timestamp나 sequence_no를 실제 발화 시각으로 해석하지 않는다.
  '''
}

Table clone_lab.context {
  id bigint [pk, increment, note: '문맥 메시지 내부 ID. 영구 분석 출처는 source_message_id 사용']
  conversation_id varchar(36) [not null, ref: > clone_lab.sessions.memory_key]
  source_message_id bigint [ref: > clone_lab.session_messages.id, note: '영구 질문·답변 쌍의 ID']
  is_active boolean [not null, default: true, note: '최근 20쌍만 true. 창에서 밀려나면 false로 논리 삭제']
  content text [not null, note: '한 메시지의 원문. 질문·답변 한 쌍은 두 행']
  type varchar(10) [not null, note: 'JDBC 호환 타입. 고정 SYSTEM 지침·요약은 실제 메모리 창에 넣지 않음']
  timestamp timestamp [not null, note: 'Spring AI 1.1.8 JDBC 저장소 정렬용. 실제 수신 시각은 session_messages에 보존']

  indexes {
    (source_message_id, type) [unique]
    (conversation_id, timestamp)
  }
  checks {
    `type IN ('USER','ASSISTANT','SYSTEM','TOOL')` [name: 'context_message_type_allowed']
  }
  Note: '''
    JdbcChatMemoryRepository용 사용자 정의 dialect로 활성 메시지만 조회한다. 창 정리는 물리 삭제 대신 비활성화한다. 임베딩은 없다.
    ChatMemory maxMessages=40은 일반 user/assistant 20쌍의 상한이다. 도구 중간 메시지는 이 창에 축적하지 않는다.
    최근 20쌍을 유지하며 오래된 쌍만 is_active=false로 전환한다. 요약 저장이 원문 창을 비우지 않는다.
    21쌍: 요약 없음·활성 2~21·비활성 1 / 40쌍: 요약 1~20·활성 21~40 / 60쌍: 요약 2개·활성 41~60.
    비활성 20쌍의 요약 저장에 성공하면 해당 context 행만 삭제한다. session_messages 원문은 유지한다.
    요약 실패 시 원문·이전 블록을 유지하고 다음 질문 처리를 재시도한다. 입력을 먼저 추가해 오래된 원문을 밀어내지 않는다.
    새 요약 저장·초과 요약 삭제·해당 메모리 블록 초기화는 같은 DB 트랜잭션으로 처리하며 실패 시 모두 롤백한다.
    서버 재시작 시 JDBC 메시지와 완료 pair_no·요약 경계로 복구한다. 세션별 전환 재검증으로 같은 구간 재삽입을 막는다.
    프롬프트는 고정 지침 → 이전 요약 최대 5개 → 현재 블록 원문 → 현재 질문 순서다. 현재 질문을 이중 추가하지 않는다.
  '''
}

Table clone_lab.context_summaries {
  id bigint [pk, increment]
  session_id bigint [not null, ref: > clone_lab.sessions.session_id]
  segment_no int [not null, note: '구간 k는 pair_no (k-1)*20+1부터 k*20까지의 완료 20쌍']
  start_message_id bigint [not null, ref: > clone_lab.session_messages.id]
  end_message_id bigint [not null, ref: > clone_lab.session_messages.id]
  content text [not null, note: '해당 구간의 독립 문맥 요약. embedding 없음']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (session_id, segment_no) [unique]
  }
  checks {
    `segment_no > 0` [name: 'summary_segment_positive']
  }
  Note: '''
    대화방별 최근 5개만 보존한다. 여섯 번째 새 요약 INSERT 성공 후 가장 작은 segment_no를 삭제한다.
    새 요약·초과분 삭제를 같은 짧은 트랜잭션으로 처리한다. 실패하면 기존 5개와 context를 그대로 유지한다.
    5개 제한은 세션 잠금 아래 서버가 처리하며 일반 CHECK로 행 개수를 제한하지 않는다. UNIQUE 인덱스로 최근 구간 조회도 지원한다.
    경계 메시지가 같은 session_id이며 pair_no가 구간 시작·끝과 일치하고 정확히 20쌍인지 서버가 검증한다.
    삭제된 예전 요약을 재시도가 다시 삽입하지 않도록 최신 완료 구간·현재 원문 경계를 저장 전 재검증한다.
    요약 원본은 context와 동일한 session_messages 원문이다. 복구 시 영구 원문에서 다시 읽는다.
    사용자 발언과 AI 반응을 구분한다. AI 추측을 사용자 사실로 바꾸지 않고 요약을 새 분석·장기 기억 근거로 재반영하지 않는다.
    viewer 요약은 해당 owner·viewer·session 문맥으로만 사용하며 owner RAG와 프로필에는 사용하지 않는다.
  '''
}

Table clone_lab.vector_store {
  id bigint [pk, increment, note: '장기 기억 문서 ID. 재시도 시 source_session_record_id로 기존 행 재사용']
  owner_id bigint [not null, ref: > clone_lab.users.id]
  source_session_record_id bigint [not null, unique, ref: > clone_lab.session_messages.id, note: '원문 한 쌍당 한 번만 장기 복사']
  content text [not null, note: 'session_messages.content 원값. 역할 구분과 사용자·AI 원문 보존']
  embedding vector(1536) [not null, note: 'session_messages.embedding 원값. 재임베딩하지 않음']
  metadata jsonb [not null, default: '{}', note: 'owner_id/viewer_id/session_id/message_id/conversation_type/record_type 및 사용자·AI 원문·출처·수신 시각. 선택: kind·occurred_at']
  conversation_type clone_lab.conversation_type [not null, default: 'owner']
  kind clone_lab.memory_kind [note: '전체 원문 복사는 NULL 허용. 대화 전체를 FACT로 단정하지 않음']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (owner_id, created_at)
  }
  checks {
    `conversation_type = 'owner'` [name: 'long_term_owner_only']
  }
  Note: '''
    최신 100쌍 밖 owner 대화만 conversation_archive로 저장한다. viewer 대화·요약은 저장하지 않는다.
    서버는 출처가 같은 owner의 owner 대화인지, 분석 저장·embedding 준비가 완료됐는지 확인한다.
    content·embedding 복사와 원문 archived 갱신은 원자적이다. 실패 시 원문 상태를 유지하며 영구 원문은 삭제하지 않는다.
    metadata.record_type=conversation_archive, owner_id 검색 필터와 원문 ID·내용·수신 시각을 서버가 설정한다.
    kind는 독립 nullable enum 컬럼이다. 복사 시 NULL이며 향후 사실 분류를 붙이더라도 AI 답변을 소유자 사실 근거로 사용하지 않는다.
    occurred_at은 명시된 실제 사건 시점이며 최초 저장·질문·응답 수신 시각과 다르다. 근거 없이 날짜를 만들지 않는다.
    최근 session_messages 후보 검색으로 부족할 때 owner_id 범위에서 검색한다. 후속 SQL에 embedding HNSW 인덱스를 추가한다.
    profile_*는 추론·선택을 보완할 뿐 사건·날짜·인물의 사실을 만들어내는 근거가 아니다.
  '''
}

// 프로필 7개 × 요소 20개는 유지한다. metadata의 근거 ID는 session_messages.id이며 context.id·요약은 새 분석 근거가 아니다.
// 프로필 저장은 사용자 행 잠금·profile_version 검사·고정 구간 ID의 중복 반영 검사를 함께 사용한다.

Table clone_lab.profile_emotion {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - clone_lab.users.id]
  uncertainty_anxiety decimal(5,2) [check: `uncertainty_anxiety BETWEEN 0 AND 100`, note: '불확실한 상황에서의 불안; 0~100 / NULL=미확인']
  threat_fear decimal(5,2) [check: `threat_fear BETWEEN 0 AND 100`, note: '위협·위험에 대한 두려움; 0~100 / NULL=미확인']
  blocked_frustration decimal(5,2) [check: `blocked_frustration BETWEEN 0 AND 100`, note: '목표가 막혔을 때의 좌절 반응; 0~100 / NULL=미확인']
  injustice_anger decimal(5,2) [check: `injustice_anger BETWEEN 0 AND 100`, note: '부당한 대우에 대한 분노 반응; 0~100 / NULL=미확인']
  loss_sadness decimal(5,2) [check: `loss_sadness BETWEEN 0 AND 100`, note: '상실 상황에서의 슬픔 반응; 0~100 / NULL=미확인']
  positive_joy decimal(5,2) [check: `positive_joy BETWEEN 0 AND 100`, note: '긍정적 사건에 대한 기쁨 반응; 0~100 / NULL=미확인']
  anticipation decimal(5,2) [check: `anticipation BETWEEN 0 AND 100`, note: '결과를 기다릴 때의 기대·흥분; 0~100 / NULL=미확인']
  public_embarrassment decimal(5,2) [check: `public_embarrassment BETWEEN 0 AND 100`, note: '공개적인 실수에 대한 당혹감; 0~100 / NULL=미확인']
  evaluation_sensitivity decimal(5,2) [check: `evaluation_sensitivity BETWEEN 0 AND 100`, note: '타인의 평가에 대한 정서적 민감성; 0~100 / NULL=미확인']
  emotional_contagion decimal(5,2) [check: `emotional_contagion BETWEEN 0 AND 100`, note: '타인의 감정에 영향받는 정도; 0~100 / NULL=미확인']
  emotion_duration decimal(5,2) [check: `emotion_duration BETWEEN 0 AND 100`, note: '감정의 지속 시간; 0~100 / NULL=미확인']
  mood_amplitude decimal(5,2) [check: `mood_amplitude BETWEEN 0 AND 100`, note: '감정 변화의 폭; 0~100 / NULL=미확인']
  recovery_speed decimal(5,2) [check: `recovery_speed BETWEEN 0 AND 100`, note: '스트레스 후 회복 속도; 0~100 / NULL=미확인']
  monotony_boredom decimal(5,2) [check: `monotony_boredom BETWEEN 0 AND 100`, note: '반복되는 단조로움에 대한 지루함; 0~100 / NULL=미확인']
  novelty_stimulation decimal(5,2) [check: `novelty_stimulation BETWEEN 0 AND 100`, note: '낯선 경험에서의 자극 추구; 0~100 / NULL=미확인']
  noise_sensitivity decimal(5,2) [check: `noise_sensitivity BETWEEN 0 AND 100`, note: '소음에 대한 민감성; 0~100 / NULL=미확인']
  visual_sensitivity decimal(5,2) [check: `visual_sensitivity BETWEEN 0 AND 100`, note: '빛·시각적 복잡성에 대한 민감성; 0~100 / NULL=미확인']
  smell_sensitivity decimal(5,2) [check: `smell_sensitivity BETWEEN 0 AND 100`, note: '냄새에 대한 민감성; 0~100 / NULL=미확인']
  touch_sensitivity decimal(5,2) [check: `touch_sensitivity BETWEEN 0 AND 100`, note: '신체 접촉·촉감에 대한 민감성; 0~100 / NULL=미확인']
  crowding_overload decimal(5,2) [check: `crowding_overload BETWEEN 0 AND 100`, note: '군중·밀집 환경에서의 과부하; 0~100 / NULL=미확인']
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'weight / sourceIds / reason']

  Note: '정서·자극 반응: 상황을 접했을 때의 감정·감각 반응. 제외: 선택 과정·실행 습관·표현 방식.'
}

Table clone_lab.profile_values {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - clone_lab.users.id]
  autonomy decimal(5,2) [check: `autonomy BETWEEN 0 AND 100`, note: '자율성; 0~100 / NULL=미확인']
  security decimal(5,2) [check: `security BETWEEN 0 AND 100`, note: '안전·안정; 0~100 / NULL=미확인']
  achievement decimal(5,2) [check: `achievement BETWEEN 0 AND 100`, note: '성취; 0~100 / NULL=미확인']
  fairness decimal(5,2) [check: `fairness BETWEEN 0 AND 100`, note: '공정; 0~100 / NULL=미확인']
  care decimal(5,2) [check: `care BETWEEN 0 AND 100`, note: '타인 배려; 0~100 / NULL=미확인']
  family decimal(5,2) [check: `family BETWEEN 0 AND 100`, note: '가족 유대; 0~100 / NULL=미확인']
  financial_comfort decimal(5,2) [check: `financial_comfort BETWEEN 0 AND 100`, note: '경제적 여유; 0~100 / NULL=미확인']
