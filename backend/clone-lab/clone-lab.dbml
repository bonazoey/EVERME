 recovery_speed decimal(5,2) [note: '스트레스 후 회복 속도; 0~100 / NULL=미확인']
 monotony_boredom decimal(5,2) [note: '반복되는 단조로움에 대한 지루함; 0~100 / NULL=미확인']
