Project CloneLab { database_type: 'PostgreSQL' }
Table clone_lab.lab_users {
 id uuid [pk]
 name text [not null]
 persona jsonb [not null]
 profile_version bigint [not null, default: 0]
 run_state jsonb [not null]
 viewer_context jsonb [not null]
 created_at timestamptz [not null]
}
Table clone_lab.batches {
 id uuid [pk]
 user_id uuid [not null, ref: > clone_lab.lab_users.id]
 topic text [not null]
 sequence_no int [not null]
 status text [not null]
 analysis jsonb
 created_at timestamptz [not null]
 indexes { (user_id, sequence_no) [unique] }
}
Table clone_lab.turns {
 id uuid [pk]
 batch_id uuid [not null, ref: > clone_lab.batches.id]
 ordinal int [not null]
 user_text text [not null]
 assistant_text text [not null]
 indexes { (batch_id, ordinal) [unique] }
}
Table clone_lab.memories {
 id uuid [pk]
 user_id uuid [not null, ref: > clone_lab.lab_users.id]
 batch_id uuid [not null, ref: > clone_lab.batches.id]
 kind text [not null]
 content text [not null]
 source_ids jsonb [not null]
 occurred_at text
 fingerprint text [not null]
 embedding vector(1536) [not null]
 indexes { (user_id, fingerprint) [unique] }
}
Table clone_lab.profile_emotion {
 user_id uuid [pk, ref: - clone_lab.lab_users.id]
 uncertainty_anxiety decimal(5,2) [note: '불확실한 상황에서의 불안; 0~100 / NULL=미확인']
